<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:LayoutXYExample.Controls">

    <Design.PreviewWith>
        <Border Padding="20" Width="300" Height="200">
            <controls:InfiniteCanvas>
                <Rectangle Width="50" Height="50" Fill="Red"/>
            </controls:InfiniteCanvas>
        </Border>
    </Design.PreviewWith>

    <ControlTheme x:Key="{x:Type controls:InfiniteCanvas}" 
                  TargetType="controls:InfiniteCanvas">
        
        <Setter Property="Background" Value="#1E1E1E" />
        <Setter Property="ClipToBounds" Value="True" />
        
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}">
                    
                    <Canvas RenderTransform="{TemplateBinding ViewportTransform}"
                            RenderTransformOrigin="0,0">
                        
                        <ContentPresenter Name="PART_ContentPresenter"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}" />
                    </Canvas>
                    
                </Border>
            </ControlTemplate>
        </Setter>
    </ControlTheme>
</ResourceDictionary>